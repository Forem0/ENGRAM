{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "engram-main",
  "description": "The bundled trace desk can request evidence operations through native selection dialogs.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy",
    "allow-get-runtime-info",
    "allow-load-demo",
    "allow-select-source",
    "allow-open-case",
    "allow-save-case",
    "allow-export-report",
    "allow-compare-case",
    "allow-finish-smoke-test"
  ]
}
